rules_version = '2';

// Every habit and completion log lives under users/{uid}/... (see
// app/src/main/java/com/atomichabits/tracker/sync/FirestoreSyncManager.kt).
// A signed-in user can only ever read or write documents under their OWN
// uid - Firebase Auth (Google Sign-In) is what proves who they are, so
// there's no separate password/URL/key to manage or leak.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
